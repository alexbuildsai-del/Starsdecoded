{
  "name": "starsdecoded",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "vercel-build": "pnpm run build:web",
    "build:web": "pnpm --filter @workspace/astra run build",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "dev:web": "pnpm --filter @workspace/astra run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:mobile": "pnpm --filter mobile run start",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:migrate": "pnpm --filter @workspace/db run migrate",
    "db:bootstrap": "./scripts/bootstrap-db.sh",
    "report:lab": "pnpm --filter @workspace/scripts run report:lab"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
