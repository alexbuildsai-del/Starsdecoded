{
  "name": "@workspace/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts && vite build --config vite.config.ts --ssr src/entry-server.tsx && node scripts/prerender.mjs && node scripts/csp.mjs --check",
    "csp:write": "node scripts/csp.mjs --write",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "TEST_TIER=critical vitest run",
    "test:deep": "vitest run"
  },
  "devDependencies": {
    "@radix-ui/react-popover": "^1.1.7",
    "@tailwindcss/typography": "^0.5.15",
