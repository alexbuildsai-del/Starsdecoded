{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../scripts/test-critical.mjs",
    "test:deep": "node --import tsx --test 'src/**/*.test.ts'",
    "walk": "tsx ./src/walk/loop.walk.ts && tsx ./src/walk/sharing.walk.ts && tsx ./src/walk/timeline.walk.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.72",
    "@clerk/shared": "^4.36.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/commerce": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/engine": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "@workspace/launch": "workspace:*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "8.7.0",
    "geo-tz": "8.1.9",
    "gpt-tokenizer": "^4.0.0",
    "pino": "^9",
    "pino-http": "^10",
    "playwright-core": "1.63.0",
    "resend": "4.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "^0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "4.2.0",
    "tsx": "catalog:"
  }
}
