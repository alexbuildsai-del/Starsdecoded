{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "has": [{ "type": "host", "value": "starsdecoded-(.*)\\.vercel\\.app" }],
      "destination": "https://REPLACE_WITH_STAGING_RAILWAY_HOST/api/$1"
    },
    {
      "source": "/api/(.*)",
      "has": [{ "type": "host", "value": "staging\\.(.*)" }],
      "destination": "https://REPLACE_WITH_STAGING_RAILWAY_HOST/api/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://workspaceapi-server-production-18dd.up.railway.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
