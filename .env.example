# Copy to .env and fill in. Never commit the filled-in file.
# Each deployment only needs the block(s) it actually runs.

# ── Database (Supabase) ─────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI).
# Prefer the connection pooler for serverless/short-lived connections.
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
# Set to "require" to connect over TLS without verifying the certificate
# chain. Managed Postgres usually needs this; sslmode in the URL alone is
# often not enough for node-postgres.
DATABASE_SSL=require

# ── Environment ─────────────────────────────────────────────────────────────
# Two Railway environments run the API from the same code: `staging` (branch
# main) and `production` (branch production). These differ between them:
#   DATABASE_URL, OPENAI_API_KEY, SESSION_SECRET, INVITE_TOKEN_SECRET,
#   PUBLIC_APP_URL, APP_ENV, PROMPTS_READ_ONLY, PROMPT_SOURCE_DATABASE_URL.
# Clerk keys and ADMIN_USER_ID are shared until a Clerk production instance
# exists. Stripe, when it lands, follows the same split: test keys on staging.
#
# Reported by /api/healthz so the smoke check can prove which API answers
# behind each web origin. Falls back to Railway's environment name.
APP_ENV=development
# Production only. Prompts are edited on staging and copied here on deploy;
# PUT/DELETE /api/admin/prompts answer 405. Explicit on purpose: flip it in
# the Railway dashboard to edit production directly during an incident.
PROMPTS_READ_ONLY=false
# Production only: the STAGING database. bootstrap-db.sh copies its
# prompt_templates into DATABASE_URL as the last bootstrap step at start. Leave unset
# everywhere else. Must never equal DATABASE_URL.
PROMPT_SOURCE_DATABASE_URL=

# ── API (Railway) ───────────────────────────────────────────────────────────
# Railway injects PORT; 8080 is the local default.
PORT=8080
NODE_ENV=production
SESSION_SECRET=

# Signs invite tokens. Must be at least 16 characters — in production the
# API throws rather than mint forgeable invite links. Falls back to
# SESSION_SECRET if unset.
INVITE_TOKEN_SECRET=

# Public origin of the WEB app (Vercel). Every email link and image is built
# from this, never from request headers; unset, the web origin for APP_ENV.
PUBLIC_APP_URL=https://mystarsdecoded.com

# Origins that may write, comma-separated, * spans one label. Unset: mystarsdecoded.com, www, starsdecoded-*.vercel.app; dev: any.
WEB_ORIGINS=

# The root middleware.ts adds it to every /api call through Vercel; the API trusts the visitor's forwarded
# address only on a call carrying it (ADR-224). Set in Vercel and in Railway: Vercel's value must equal that
# of the Railway environment its /api reaches. At least 32 characters, since /api/healthz answers whether a
# call carried it: `openssl rand -hex 32` makes one. Shorter once trimmed counts as unset on both sides; unset,
# every per-address limit keys on the address Railway saw.
EDGE_PROXY_SECRET=

# pino level (trace, debug, info, warn, error, fatal, silent); unset means info.
LOG_LEVEL=

# ── AI (OpenAI) ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Only when routing through a proxy or OpenAI-compatible gateway.
# OPENAI_BASE_URL=
# Generation spend cap per UTC day, in USD: past it, writing answers 503 paused. Unset means 20; 0 pauses all writing (MB-145).
DAILY_SPEND_CAP_USD=

# ── Report lab and release (staging only; no secret on GitHub, ever) ────────
# Monthly cap on lab spend, summed from lab_runs; spots, sessions, the
# release lab and the study notes refuse beyond it. Defaults to 15 (ADR-77).
LAB_BUDGET_USD=
# Fine-grained GitHub token, this repository, Contents write: the admin
# Release view fast-forwards the production branch with it (MB-75). Railway
# staging Variables only; never production, never GitHub.
GITHUB_RELEASE_TOKEN=
# The QA agent's model, a models.ts id; unset means the catalogue's default.
QA_AGENT_MODEL=
# Where headless Chromium is on the image; nixpacks.toml sets it (MB-77).
QA_BROWSER_PATH=

# ── Auth (Clerk) ────────────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
# Clerk user id of the owner account. Gates /admin/prompts and /api/admin/*.
# Find yours at /api/admin/me while signed in.
ADMIN_USER_ID=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Stars Decoded <noreply@mystarsdecoded.com>

# ── Web (Vercel) ────────────────────────────────────────────────────────────
# Origin of the API deployment. Leave empty on Vercel, where vercel.json
# rewrites same-origin /api to Railway (staging or production by host), and
# for local dev, where Vite proxies /api to localhost:8080. VITE_* values are
# inlined into the client bundle — never put a secret in one. The Vercel build
# ignores this variable regardless (vite.config.ts), because a value here
# points the web at the wrong API: a scheme-less host once resolved to a bogus
# same-origin path and 405'd every report. Do not set it on Vercel.
VITE_API_BASE_URL=

# Derived at build time from Vercel's VERCEL_ENV (production → production,
# anything else → staging). Set only to check the staging ribbon locally.
# VITE_APP_ENV=staging

# The web app throws at startup without this — a missing value is a blank
# page, not a degraded one. Same publishable key as the API's, pk_ prefixed
# and safe to ship in the bundle.
VITE_CLERK_PUBLISHABLE_KEY=pk_...

# ── Mobile (Expo) ───────────────────────────────────────────────────────────
# EXPO_PUBLIC_* is likewise inlined into the app bundle. No secrets.
EXPO_PUBLIC_API_URL=https://starsdecoded-api.up.railway.app
